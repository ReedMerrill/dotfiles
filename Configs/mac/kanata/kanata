#!/bin/bash

# Configuration
STATE_FILE="/Users/reed/kanata/.kanata_state"
KANATA_EXEC="/Users/reed/kanata/kanata_1.12_macos_cmd_allowed_arm64"
CONFIG_A="/Users/reed/kanata/macos-60pct-layout.kbd"
CONFIG_B="/Users/reed/kanata/macos-internal-layout.kbd"

# Helper to run kanata and wait for it silently
run_kanata_and_wait() {
    local config=$1
    # --release-grab-on-lock hands the keyboard back on lock/user-switch and
    # re-grabs on unlock. It is off by default upstream; it replaces the
    # unlock watchdog this script used to spawn.
    # --no-wait exits instead of blocking on "Press enter to exit", so a
    # startup failure (e.g. no device matches macos-dev-names-include)
    # surfaces immediately instead of hanging.
    sudo "$KANATA_EXEC" --cfg "$config" --release-grab-on-lock --no-wait &
    local kanata_pid=$!

    # Ignore SIGTERM so we don't print "Terminated" when another invocation
    # of this script kills us
    trap 'exit 0' SIGTERM

    # Wait for the process to finish
    wait $kanata_pid 2>/dev/null
}

# Pick a config: "kanata a" or "kanata b" to choose, bare "kanata" to toggle
CURRENT_STATE=$(cat "$STATE_FILE" 2>/dev/null || echo "b")

case "$1" in
    a|b)
        NEW_STATE="$1"
        ;;
    "")
        if [[ "$CURRENT_STATE" == "a" ]]; then
            NEW_STATE="b"
        else
            NEW_STATE="a"
        fi
        ;;
    *)
        echo "usage: kanata [a|b]" >&2
        exit 2
        ;;
esac

sudo pkill -f "$KANATA_EXEC" >/dev/null 2>&1
sleep 0.2

if [[ "$NEW_STATE" == "a" ]]; then
    echo "Switching to Kanata config A"
    echo "a" > "$STATE_FILE"
    run_kanata_and_wait "$CONFIG_A"
else
    echo "Switching to Kanata config B"
    echo "b" > "$STATE_FILE"
    run_kanata_and_wait "$CONFIG_B"
fi
