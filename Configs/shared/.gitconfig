[init]
	defaultBranch = main
[user]
	email = reedjmerrill@gmail.com
	name = Reed Merrill
[pull]
	rebase = true
[core]
    pager = delta
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true  # use n and N to move between diff sections
    dark = true      # or light = true, or omit for auto-detection
    features = gruvmax-fang
[merge]
    conflictStyle = zdiff3
[include]
    path = /Users/reed/.config/delta-git/themes.gitconfig
